#!/usr/bin/env bash

set -euo pipefail
# Disable glob expansion to handle brackets in file paths
set -f
usage() {
  cat >&2 <<EOF
Usage: $(basename "$0") [-m message] [--force] [--dry-run] "file" ["file" ...]

Options:
  -m message       Commit message (required, unless using --dry-run)
                     First line is subject. Rest is body.
  --force          Auto-remove stale .git/index.lock
  --dry-run        Stage files and show diff without committing

Examples:
  $(basename "$0") -m "Add login page" auth.rb
  $(basename "$0") -m "Add login page

Add a login page with JWT auth" auth.rb
  $(basename "$0") -m "Fix deadlock in pool" --force app/db.rb
  $(basename "$0") -m "Add login page" --dry-run auth.rb
EOF
  exit 2
}

commit_message=""
commit_subject=""
force_delete_lock=false
dry_run=false

# Parse options
while [ $# -gt 0 ]; do
  case "$1" in
    -m)
      if [ $# -lt 2 ]; then
        printf 'Error: -m requires a message argument\n' >&2
        exit 2
      fi
      commit_message="$2"
      shift 2
      ;;
    --force)
      force_delete_lock=true
      shift
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    *)
      break
      ;;
  esac
done

files=("$@")

if [ ${#files[@]} -eq 0 ] && [ -z "$commit_message" ] && [ "$dry_run" = false ]; then
  usage
fi

if [ -z "$commit_message" ] && [ "$dry_run" = false ]; then
  printf 'Error: -m message is required\n' >&2
  exit 2
fi

if [[ "$commit_message" != *[![:space:]]* ]] && [ "$dry_run" = false ]; then
  printf 'Error: commit message must not be empty\n' >&2
  exit 1
fi

# Extract first line (subject) for display; rest is body
commit_subject=$(printf '%s' "$commit_message" | head -n1)

if [ "$dry_run" = true ]; then
  git restore --staged :/
  git add -A -- "${files[@]}"
  if git diff --staged --quiet; then
    printf 'Warning: no staged changes detected for: %s\n' "${files[*]}" >&2
    exit 1
  fi
  printf 'Dry run — staged changes:\n\n'
  git diff --staged --color=always
  exit 0
fi

# Disallow "." because it stages the entire repository and defeats the helper's safety guardrails.
for file in "${files[@]}"; do
  if [ "$file" = "." ]; then
    printf 'Error: "." is not allowed; list specific paths instead\n' >&2
    exit 1
  fi
done

last_commit_error=''

run_git_commit() {
  local stderr_log
  stderr_log=$(mktemp)
  if git commit -m "$commit_message" -- "${files[@]}" 2> >(tee "$stderr_log" >&2); then
    rm -f "$stderr_log"
    last_commit_error=''
    return 0
  fi

  last_commit_error=$(cat "$stderr_log")
  rm -f "$stderr_log"
  return 1
}

for file in "${files[@]}"; do
  if [ ! -e "$file" ]; then
    # Allow staging deletions: when a file is removed from disk, it may no longer exist in the index
    # (once staged for deletion), but it can still exist in HEAD.
    if ! git ls-files --error-unmatch -- "$file" >/dev/null 2>&1; then
      if ! git cat-file -e "HEAD:$file" >/dev/null 2>&1; then
        printf 'Error: file not found: %s\n' "$file" >&2
        exit 1
      fi
    fi
  fi
done

git restore --staged :/
git add -A -- "${files[@]}"

if git diff --staged --quiet; then
  printf 'Warning: no staged changes detected for: %s\n' "${files[*]}" >&2
  exit 1
fi

committed=false
if run_git_commit; then
  committed=true
elif [ "$force_delete_lock" = true ]; then
  lock_path=$(
    printf '%s\n' "$last_commit_error" |
      awk -F"'" '/Unable to create .*\.git\/index\.lock/ { print $2; exit }'
  )

  if [ -n "$lock_path" ] && [ -e "$lock_path" ]; then
    rm -f "$lock_path"
    printf 'Removed stale git lock: %s\n' "$lock_path" >&2
    if run_git_commit; then
      committed=true
    fi
  fi
fi

if [ "$committed" = false ]; then
  exit 1
fi

printf 'Committed "%s" with %d files\n' "$commit_subject" "${#files[@]}"
